[Unit]
Description=UPang Safety System API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/Upang-safety-and-report-system-backend-api
EnvironmentFile=/etc/upang-safety.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/Upang-safety-and-report-system-backend-api/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target